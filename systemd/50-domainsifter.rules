// Allow the domainsifter user to start the archive service
// triggered by ExecStartPost from domainsifter.service. Scoped
// to exactly that one unit — no other systemctl operations are
// granted.
//
// Installed to /etc/polkit-1/rules.d/50-domainsifter.rules via
// scripts/deploy_systemd.sh.
//
// Background: 2026-05-19 06:30 UTC cron showed
//   systemctl[140062]: Failed to start domainsifter-archive.service:
//   Interactive authentication required.
// because polkit's default policy requires interactive auth for
// user-initiated unit management. This rule removes that requirement
// for our specific cross-unit trigger pattern.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "domainsifter-archive.service" &&
        subject.user == "domainsifter") {
        return polkit.Result.YES;
    }
});
