# DomainSifter daily pipeline service — self-hosted on OVH (Debian 12).
# Replaces the previous GitHub Actions cron path. The GHA workflow at
# .github/workflows/daily-diff.yml is kept as a manual fallback via
# workflow_dispatch; this service is the production daily runner as of
# 2026-05-11.
#
# ExecStart invokes run-daily-with-guard.sh (the wrapper) instead of
# run-daily.sh directly. The wrapper enforces a same-day guard: if a
# pipeline invocation already completed today (UTC), it skips. This
# closes the failure mode that surfaced on 2026-05-21 when a timer
# restart triggered a Persistent=true catch-up after a successful
# manual recovery, which would have re-corrupted R2 state if not
# killed in flight. See scripts/run-daily-with-guard.sh and RECOVERY.md
# for the full design.
#
# To force a same-day re-run (e.g., morning run published bad data and
# operator wants to republish after a config fix), use the sibling
# unit:  sudo systemctl start domainsifter-force.service
#
# INSTALL (server-side, run as root once):
#   cp /home/domainsifter/domainsifter/systemd/domainsifter.service         /etc/systemd/system/
#   cp /home/domainsifter/domainsifter/systemd/domainsifter.timer           /etc/systemd/system/
#   cp /home/domainsifter/domainsifter/systemd/domainsifter-archive.service /etc/systemd/system/
#   cp /home/domainsifter/domainsifter/systemd/domainsifter-force.service   /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now domainsifter.timer
#   systemctl enable domainsifter-archive.service
#   systemctl list-timers       # confirm the next 06:30 UTC firing
#
# Logs: journalctl -u domainsifter.service -f
# Manual trigger (testing): systemctl start domainsifter.service

[Unit]
Description=DomainSifter daily pipeline
After=network-online.target
Wants=network-online.target
# Chain the archive page generator on successful pipeline completion.
# systemd queues the start job internally when this unit transitions to
# inactive with exit code 0 — same trigger semantics as the prior
# ExecStartPost=/bin/systemctl start pattern, but processed by PID 1
# instead of user-space, so no RemainAfterExit hack and no polkit
# round-trip needed. Available since systemd 249; Debian 12 has 252.
OnSuccess=domainsifter-archive.service

[Service]
Type=oneshot
User=domainsifter
Group=domainsifter
WorkingDirectory=/home/domainsifter/domainsifter
EnvironmentFile=/home/domainsifter/domainsifter/.env
ExecStart=/home/domainsifter/domainsifter/scripts/run-daily-with-guard.sh
StandardOutput=journal
StandardError=journal
# Explicit memory accounting so `systemctl show -p MemoryPeak` reports a
# real number for the email report. Default-on for systemd 252+ (Debian 12)
# but pinned for forward-portability.
MemoryAccounting=yes
