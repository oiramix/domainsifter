# DomainSifter daily pipeline service — self-hosted on OVH (Debian 12).
# Replaces the previous GitHub Actions cron path. The GHA workflow at
# .github/workflows/daily-diff.yml is kept as a manual fallback via
# workflow_dispatch; this service is the production daily runner as of
# 2026-05-11.
#
# INSTALL (server-side, run as root once):
#   cp /home/domainsifter/domainsifter/systemd/domainsifter.service         /etc/systemd/system/
#   cp /home/domainsifter/domainsifter/systemd/domainsifter.timer           /etc/systemd/system/
#   cp /home/domainsifter/domainsifter/systemd/domainsifter-archive.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now domainsifter.timer
#   systemctl enable domainsifter-archive.service
#   systemctl list-timers       # confirm the next 06:30 UTC firing
#
# Logs: journalctl -u domainsifter.service -f
# Manual trigger (testing): systemctl start domainsifter.service

[Unit]
Description=DomainSifter daily pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Stay "active (exited)" after ExecStart+ExecStartPost finish, so that
# domainsifter-archive.service's Requires=domainsifter.service check still
# passes when systemd processes the start job queued by ExecStartPost.
# Without this, oneshot transitions to inactive (dead) immediately after
# ExecStartPost returns — the archive service's start job then sees
# domainsifter.service as inactive and fails with "Dependency failed".
# This is why no /d/ pages were chain-generated between the 2026-05-17
# chain install and 2026-05-18: the archive service never ran.
RemainAfterExit=yes
User=domainsifter
Group=domainsifter
WorkingDirectory=/home/domainsifter/domainsifter
EnvironmentFile=/home/domainsifter/domainsifter/.env
ExecStart=/home/domainsifter/domainsifter/scripts/run-daily.sh
ExecStartPost=/bin/systemctl start --no-block domainsifter-archive.service
StandardOutput=journal
StandardError=journal
# Explicit memory accounting so `systemctl show -p MemoryPeak` reports a
# real number for the email report. Default-on for systemd 252+ (Debian 12)
# but pinned for forward-portability.
MemoryAccounting=yes
