---
// Browseable archive index. Paginated 50/page via Astro's paginate()
// helper. Page 1 → /archive, page 2 → /archive/2, etc. (the [...page]
// catch-all collapses the first segment to nothing).
//
// Filter controls (TLD selector, verdict filter) are client-side only —
// the dataset is already in the rendered HTML so JS can hide/show rows
// without a round trip. No URL state for filters yet (would require
// per-permutation static pages; scope creep).
import { getCollection } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// PAGE_SIZE inlined inside getStaticPaths — Astro hoists this function to
// its own module scope at build, so frontmatter consts aren't visible inside.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const entries = await getCollection('archive');
  // Newest archived first so the front page is the most recent additions.
  const sorted = entries.sort((a, b) =>
    b.data.archived_date.localeCompare(a.data.archived_date),
  );
  return paginate(sorted, { pageSize: 50 });
}

const { page } = Astro.props;
const allEntries = await getCollection('archive');
const tldsInArchive = Array.from(
  new Set(allEntries.map((e) => e.data.tld)),
).sort();
const earliestDate = allEntries
  .map((e) => e.data.archived_date)
  .sort()[0] ?? null;

const totalEntries = allEntries.length;
const pageNumber = page.currentPage;
const totalPages = page.lastPage;

const verdictPill = (v: string) =>
  v === 'Clean'
    ? 'bg-emerald-50 text-emerald-800 ring-emerald-200'
    : 'bg-amber-50 text-amber-900 ring-amber-200';

const pageTitle =
  pageNumber === 1
    ? 'DomainSifter archive — every Clean and Promising domain we have evaluated'
    : `DomainSifter archive — page ${pageNumber}`;
const pageDesc =
  totalEntries === 0
    ? 'Permanent records of every expired domain DomainSifter has evaluated. Archive begins after the first daily run lands.'
    : `Permanent records of every expired domain DomainSifter has evaluated. ${totalEntries} domains archived since ${earliestDate}.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <Header />
  <main id="main" class="mx-auto max-w-5xl px-4 sm:px-6 py-8 sm:py-12">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">DomainSifter archive</h1>
    <p class="mt-3 text-stone-600 max-w-2xl">
      {totalEntries === 0
        ? 'Permanent records of every Clean and Promising expired domain DomainSifter has evaluated. The archive grows daily — the first entry will appear after the next pipeline run.'
        : `Permanent records of every Clean and Promising expired domain DomainSifter has evaluated. Browsing ${totalEntries.toLocaleString('en-US')} domains archived since ${earliestDate}.`}
    </p>

    {totalEntries > 0 && (
      <div class="mt-6 flex flex-col sm:flex-row gap-3 sm:items-center">
        <label class="text-sm text-stone-600" for="archive-tld">TLD:</label>
        <select id="archive-tld" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm">
          <option value="all">All TLDs</option>
          {tldsInArchive.map((t) => <option value={t}>.{t}</option>)}
        </select>
        <label class="text-sm text-stone-600 sm:ml-4" for="archive-verdict">Verdict:</label>
        <select id="archive-verdict" class="rounded-md border border-stone-300 bg-white px-3 py-1.5 text-sm">
          <option value="all">All</option>
          <option value="Clean">Clean</option>
          <option value="Promising">Promising</option>
        </select>
      </div>
    )}

    {totalEntries > 0 ? (
      <table class="mt-6 w-full text-sm border-collapse" data-archive-table>
        <thead>
          <tr class="border-b border-stone-300 text-left text-xs uppercase tracking-wide text-stone-500">
            <th class="py-2 pr-3 font-medium">Domain</th>
            <th class="py-2 pr-3 font-medium">TLD</th>
            <th class="py-2 pr-3 font-medium">Archived</th>
            <th class="py-2 pr-3 font-medium">Verdict</th>
            <th class="py-2 pr-3 font-medium text-right">Score</th>
            <th class="py-2 pr-3 font-medium text-right">Wayback</th>
          </tr>
        </thead>
        <tbody>
          {page.data.map((e) => (
            <tr
              class="border-b border-stone-100 hover:bg-stone-50"
              data-tld={e.data.tld}
              data-verdict={e.data.verdict}
            >
              <td class="py-2 pr-3">
                <a href={`/d/${e.data.name}`} class="text-accent hover:underline font-medium">
                  {e.data.name}
                </a>
              </td>
              <td class="py-2 pr-3 text-stone-600">.{e.data.tld}</td>
              <td class="py-2 pr-3 text-stone-600">{e.data.archived_date}</td>
              <td class="py-2 pr-3">
                <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictPill(e.data.verdict)}`}>
                  {e.data.verdict}
                </span>
              </td>
              <td class="py-2 pr-3 text-right">{e.data.score}</td>
              <td class="py-2 pr-3 text-right text-stone-600">
                {e.data.wayback_snapshots?.toLocaleString('en-US') ?? '—'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p class="mt-6 text-stone-500 italic">No archived domains yet. Check back tomorrow.</p>
    )}

    {totalPages > 1 && (
      <nav class="mt-8 flex items-center justify-between text-sm" aria-label="Pagination">
        <span class="text-stone-500">Page {pageNumber} of {totalPages}</span>
        <div class="flex items-center gap-2">
          {page.url.prev && (
            <a href={page.url.prev} class="px-3 py-1.5 border border-stone-300 rounded hover:bg-stone-50">
              ← Previous
            </a>
          )}
          {page.url.next && (
            <a href={page.url.next} class="px-3 py-1.5 border border-stone-300 rounded hover:bg-stone-50">
              Next →
            </a>
          )}
        </div>
      </nav>
    )}

    <footer class="mt-12 border-t border-stone-200 pt-6 text-sm text-stone-500">
      <a href="/sitemap-index.xml" class="text-accent hover:underline">Sitemap</a>
      <span class="mx-2">·</span>
      <a href="/" class="text-accent hover:underline">Home</a>
    </footer>
  </main>
  <Footer />
</Layout>

<script is:inline>
  // Client-side filter — operates on the rendered rows only (the current
  // page's 50; users hit Previous/Next for other pages). No URL state.
  (function () {
    const tldSel = document.getElementById('archive-tld');
    const verdictSel = document.getElementById('archive-verdict');
    const tbody = document.querySelector('[data-archive-table] tbody');
    if (!tbody || !tldSel || !verdictSel) return;
    const rows = Array.from(tbody.querySelectorAll('tr'));
    function apply() {
      const tld = tldSel.value;
      const verdict = verdictSel.value;
      for (const row of rows) {
        const matchTld = tld === 'all' || row.dataset.tld === tld;
        const matchVerdict = verdict === 'all' || row.dataset.verdict === verdict;
        row.style.display = matchTld && matchVerdict ? '' : 'none';
      }
    }
    tldSel.addEventListener('change', apply);
    verdictSel.addEventListener('change', apply);
  })();
</script>
