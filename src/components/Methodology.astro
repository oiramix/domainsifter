---
// Eight-stage walkthrough of the actual pipeline. Reading order
// (top-to-bottom, left-to-right at the 3-col breakpoint) matches
// the pipeline data flow:
//   1. catch    → 2. filter   → 3. verify
//   4. enrich   → 5. backlinks → 6. snapshot
//   7. score    → 8. publish
// Step 6 added 2026-05-20 with the snapshot content classifier wire-in.
// Icons are inline SVGs (Lucide-style stroke geometry) so we don't
// need a runtime icon library; matches the existing antenna/sift/check
// treatment from the prior 3-card version.
const steps = [
  {
    icon: 'antenna',
    title: 'Catch the drop',
    body: 'We monitor ICANN zone files across 15 TLDs every day. The moment a domain expires, we see it.',
  },
  {
    icon: 'filter',
    title: 'Filter the obvious junk',
    body: 'Punycode, gibberish, and known abuse keywords are rejected on sight. Most of the daily noise stops here.',
  },
  {
    icon: 'shield-check',
    title: 'Verify availability',
    body: 'Most domains absent from a zone file aren’t actually free — they’re in transfer, on hold, or paused. We check each one via RDAP before publishing.',
  },
  {
    icon: 'database',
    title: 'Enrich with real data',
    body: 'Each survivor gets checked against Wayback Machine, OpenPageRank, certificate transparency logs, and three spam blocklists.',
  },
  {
    icon: 'link-2',
    title: 'Check backlinks',
    body: 'Each domain is checked against the Common Crawl domain webgraph (released monthly, covering a rolling 3-month window of the live web). The backlinks count shows how many distinct source domains linked to it during that window.',
  },
  {
    icon: 'eye',
    title: 'Review snapshot content',
    body: 'We pull the most recent Wayback snapshot of each domain and read the page content. Toxic snapshots (adult, gambling spam, malware) are rejected. Parked or empty pages get a Caution verdict regardless of other signals.',
  },
  {
    icon: 'bar-chart',
    title: 'Score and rank',
    body: 'We weight historical authority, certificate history, and domain quality into a single score. Junk and weak candidates get rejected at the quality floor.',
  },
  {
    icon: 'file-check',
    title: 'Publish what’s left',
    body: 'The strongest candidates make today’s list. Clean, register-ready, no surprises.',
  },
];
---

<section id="methodology" class="border-t border-stone-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent uppercase tracking-wide">How it works</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">
        From raw drop to register-ready, in one pass.
      </h2>
    </div>

    {/*
      Grid sizing:
        mobile (default):  1 column, 6 rows
        sm (≥640px):       2 columns × 3 rows
        lg (≥1024px):      3 columns × 2 rows
      Reading order top→bottom, left→right matches pipeline order at every
      breakpoint. Equal heights via stretch (default for grid items) keep
      the cards visually parallel even when copy lengths differ slightly.
    */}
    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((step, idx) => (
          <li class="relative rounded-lg border border-stone-200 bg-paper p-6">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-accent/10 text-accent">
                {step.icon === 'antenna' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12a7 7 0 0 1 14 0" />
                    <path d="M8.5 12a3.5 3.5 0 0 1 7 0" />
                    <circle cx="12" cy="12" r="1" />
                    <path d="M12 13v8" />
                  </svg>
                )}
                {step.icon === 'filter' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 5h18l-7 9v5l-4-2v-3Z" />
                  </svg>
                )}
                {step.icon === 'shield-check' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3 4 6v6c0 4.5 3.5 8 8 9 4.5-1 8-4.5 8-9V6Z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {step.icon === 'database' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="8" ry="3" />
                    <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                    <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                  </svg>
                )}
                {step.icon === 'link-2' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 17H7A5 5 0 0 1 7 7h2" />
                    <path d="M15 7h2a5 5 0 1 1 0 10h-2" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                  </svg>
                )}
                {step.icon === 'eye' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                )}
                {step.icon === 'bar-chart' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 21h18" />
                    <path d="M7 17v-5" />
                    <path d="M12 17V7" />
                    <path d="M17 17v-8" />
                  </svg>
                )}
                {step.icon === 'file-check' && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" />
                    <path d="M14 3v6h6" />
                    <path d="m9 15 2 2 4-4" />
                  </svg>
                )}
              </span>
              <span class="text-xs font-medium text-stone-500">Step {idx + 1}</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 text-stone-600 leading-relaxed text-sm">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
