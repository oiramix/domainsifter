---
import samplePayload from '../data/sample-domains.json';

// Pipeline output (locked schema — PLAN.md Principle 5).
// Migrations applied:
//   2026-04-27 evening: single affiliate_link → registrars[]
//   2026-04-30:        added first_seen_date / last_validated_date /
//                      days_listed for the 14-day persistent rolling list,
//                      plus top-level today_count / carryover_count.
//   2026-05-14:        added cc_source_domain_count (Common Crawl
//                      backlinks). Optional — older payloads and the
//                      preview/sample fallback may omit it.
interface RegistrarLink {
  name: string;                    // "Namecheap", "NameSilo", ...
  url: string;                     // affiliate URL with {name} substituted
}

interface PipelineDomain {
  name: string;
  tld: string;
  dropped_date: string;            // ISO YYYY-MM-DD
  wayback_snapshots: number | null;
  wayback_last_snapshot: string | null;
  open_page_rank: number | null;
  cert_history: boolean | null;
  previous_registrar: string | null;
  score: number;                   // 0–100
  registrars: RegistrarLink[];
  // Persistent-list fields (optional in older payloads / sample data)
  first_seen_date?: string | null;
  last_validated_date?: string | null;
  days_listed?: number;            // 0 = today, >0 = carryover
  // Common Crawl backlinks (added 2026-05-14, wire-in commit).
  // Integer count of distinct source domains observed linking to the apex
  // in the latest CC release; null when the apex isn't in that release's
  // graph at all. Older payloads and sample data omit it entirely.
  cc_source_domain_count?: number | null;
}

interface PipelinePayload {
  generated_at: string;
  domain_count: number;
  domains: PipelineDomain[];
  total_candidates_evaluated?: number;
  today_count?: number;
  carryover_count?: number;
}

type Verdict = 'Clean' | 'Promising' | 'Caution';

// --- Data source resolution ---------------------------------------------------
// Pipeline writes src/data/daily-domains.json; sample-domains.json is the
// cold-start / pipeline-failed fallback so the page always renders.
// import.meta.glob handles missing-file gracefully (eager-loaded matches
// yield {} when the path doesn't exist), unlike a static import.
const dailyMatches = import.meta.glob<{ default: PipelinePayload }>(
  '../data/daily-domains.json',
  { eager: true },
);
const dailyPayload = Object.values(dailyMatches)[0]?.default;

const isPreview = !dailyPayload || !dailyPayload.domains || dailyPayload.domains.length === 0;
const payload: PipelinePayload = isPreview
  ? (samplePayload as PipelinePayload)
  : (dailyPayload as PipelinePayload);
const allDomains = payload.domains;

// Split into the two card buckets. days_listed === 0 → today; > 0 → carryover.
// Missing / undefined days_listed (sample data, migration) → treated as today.
const todayDomains = allDomains.filter((d) => (d.days_listed ?? 0) === 0);
const carryoverDomains = allDomains.filter((d) => (d.days_listed ?? 0) > 0);

const lastUpdatedLabel = isPreview
  ? 'Preview data'
  : new Date(payload.generated_at).toUTCString().replace('GMT', 'UTC');

const tldsInData = Array.from(new Set(allDomains.map((d) => d.tld))).sort();

// "Evaluated today" — the count of candidates that entered availability
// check today (the dominant filter). Pipeline writes
// total_candidates_evaluated; older payloads / sample data fall back to
// the today bucket size so we still report something honest.
const totalEvaluated = (!isPreview && payload.total_candidates_evaluated)
  ? payload.total_candidates_evaluated
  : todayDomains.length;

// --- Display helpers ----------------------------------------------------------

const verdictFromScore = (score: number): Verdict => {
  if (score >= 70) return 'Clean';
  if (score >= 40) return 'Promising';
  return 'Caution';
};

const droppedDaysAgo = (isoDate: string): string => {
  const dropped = new Date(`${isoDate}T00:00:00Z`);
  const now = new Date();
  const ms = now.getTime() - dropped.getTime();
  const days = Math.floor(ms / (1000 * 60 * 60 * 24));
  if (days <= 0) return 'today';
  if (days === 1) return '1 day ago';
  return `${days} days ago`;
};

// "Listed" column label — purely from days_listed (computed pipeline-side
// at write time so the value is stable across browser timezones).
const listedAgo = (days: number | undefined | null): string => {
  if (days == null || days <= 0) return 'today';
  if (days === 1) return '1 day ago';
  return `${days} days ago`;
};

// --- Null-safe formatters ----------------------------------------------------
const DASH = '—';
const fmtInt = (v: number | null | undefined): string =>
  v == null ? DASH : v.toLocaleString('en-US');
const fmtDecimal = (v: number | null | undefined, digits = 1): string =>
  v == null ? DASH : v.toFixed(digits);
const oprPct = (v: number | null | undefined): number =>
  v == null ? 0 : Math.max(0, Math.min(100, (v / 10) * 100));

const tldClass = (tld: string) => {
  switch (tld) {
    case 'org':
      return 'bg-violet-50 text-violet-800 ring-violet-200';
    case 'info':
      return 'bg-emerald-50 text-emerald-800 ring-emerald-200';
    case 'dev':
      return 'bg-sky-50 text-sky-800 ring-sky-200';
    case 'app':
      return 'bg-amber-50 text-amber-800 ring-amber-200';
    case 'tech':
    case 'studio':
      return 'bg-indigo-50 text-indigo-800 ring-indigo-200';
    case 'xyz':
      return 'bg-rose-50 text-rose-800 ring-rose-200';
    default:
      return 'bg-stone-100 text-stone-700 ring-stone-200';
  }
};

const REGISTRAR_LOGOS: Record<string, string> = {
  'Namecheap': '/registrar-logos/namecheap.png',
  'NameSilo':  '/registrar-logos/namesilo.png',
  'Dynadot':   '/registrar-logos/dynadot.png',
};

const verdictClass = (verdict: Verdict) => {
  switch (verdict) {
    case 'Clean':
      return 'bg-emerald-50 text-emerald-800 ring-emerald-200';
    case 'Promising':
      return 'bg-amber-50 text-amber-900 ring-amber-200';
    case 'Caution':
      return 'bg-rose-50 text-rose-800 ring-rose-200';
  }
};

// Subheader sentences for each card — driven by counts so we don't lie.
const todaySubheader = (n: number): string => {
  if (n === 0) return 'No new drops yet today';
  if (n === 1) return '1 domain added today';
  return `${n.toLocaleString('en-US')} domains added today`;
};
const carryoverSubheader = (n: number): string => {
  if (n === 0) return 'Listed up to 14 days, no entries yet';
  if (n === 1) return 'Listed up to 14 days, 1 domain';
  return `Listed up to 14 days, ${n.toLocaleString('en-US')} domains`;
};
---

<section id="today" class="mx-auto max-w-6xl px-4 sm:px-6 pt-6 pb-12 sm:pt-8 sm:pb-16">
  <!-- Shared header bar: title, last-updated, search, TLD filter.
       Filter + search apply to BOTH cards simultaneously. -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">Drops</h2>
        {isPreview && (
          <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-900 ring-1 ring-inset ring-amber-200">
            Preview data
          </span>
        )}
      </div>
      <p class="mt-2 text-sm text-stone-600">
        <span data-total-evaluated={totalEvaluated}>
          Evaluated {totalEvaluated.toLocaleString('en-US')} candidates today
        </span>
        <span class="text-stone-400"> • </span>
        <span>
          Last updated: <span data-last-updated>{lastUpdatedLabel}</span>
        </span>
      </p>
      <p class="mt-1 text-sm text-stone-600">
        Availability checked at last update. Popular drops can be claimed within hours — verify at the registrar before buying.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
      <label class="sr-only" for="domain-search">Search domains</label>
      <div class="relative">
        <input
          id="domain-search"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="Search domains…"
          class="w-full sm:w-64 rounded-md border border-stone-300 bg-white pl-9 pr-3 py-2 text-sm text-ink placeholder:text-stone-400 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
        />
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="9" cy="9" r="6" />
          <path d="m14 14 4 4" stroke-linecap="round" />
        </svg>
      </div>

      <label class="sr-only" for="tld-filter">Filter by TLD</label>
      <select
        id="tld-filter"
        class="rounded-md border border-stone-300 bg-white px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      >
        <option value="all">All TLDs</option>
        {tldsInData.map((t) => <option value={t}>.{t} only</option>)}
      </select>
    </div>
  </div>

  <!-- =============== CARD 1: Today's drops =============== -->
  <article
    data-card-scope="today"
    class="rounded-lg border border-stone-200 bg-white shadow-sm mb-6"
  >
    <header class="px-4 sm:px-6 py-4 border-b border-stone-100">
      <h3 class="text-lg font-semibold text-ink">Today's drops</h3>
      <p class="mt-1 text-sm text-stone-600" data-today-subheader>
        {todaySubheader(todayDomains.length)}
      </p>
    </header>

    {/* Empty state for Card 1 — shown when no new drops cleared the bar today.
        Real-data days when the pipeline returns 0 today_count are common
        early in the project's life; this is the right copy for that case. */}
    {todayDomains.length === 0 && !isPreview && (
      <div class="px-4 sm:px-6 py-10 text-center" data-today-empty-real>
        <p class="text-sm text-stone-700">
          No new drops met our quality bar today. Check the still-available
          list below.
        </p>
      </div>
    )}

    {todayDomains.length > 0 && (
      <>
        <!-- Desktop table — max-height + scroll for >20 rows. -->
        <div class="hidden md:block max-h-[60rem] overflow-y-auto rounded-b-lg">
          {/*
            CSS Grid replaces the <table> markup. Each row is its own grid
            container with the SAME explicit grid-cols template, so columns
            align across rows. Column widths are content-sized fixed pixels
            for everything except the last (Register), which uses 1fr to
            absorb all card slack — that empty space on the right of the
            Register button is intentional, and it's where the registrar-icon
            popover renders INLINE when the button is clicked. No absolute
            positioning, no scroll-clip issues, no <td>-as-containing-block
            inconsistencies.

            Semantics: role="table"/"row"/"cell"/"columnheader" so screen
            readers still treat this as tabular data even though the markup
            is divs. Tested with VoiceOver — announces as table with N
            columns / M rows.
          */}
          <div role="table" class="w-full text-sm" data-domain-table data-table-scope="today">
            <div role="rowgroup" class="sticky top-0 z-10 bg-stone-50 text-stone-600 border-b border-stone-100">
              <div role="row" class="grid grid-cols-[200px_80px_110px_110px_180px_110px_120px_1fr] font-medium">
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="name">
                    Domain <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="tld">
                    TLD <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="dropped">
                    Dropped <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="wayback">
                    Wayback <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="opr">
                    OpenPageRank <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="backlinks">
                    Backlinks <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="score">
                    Verdict <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader" class="px-4 py-3 text-left">Register</div>
              </div>
            </div>
            <div role="rowgroup" class="divide-y divide-stone-100" data-table-body data-scope="today">
              {todayDomains.map((d, i) => {
                const verdict = verdictFromScore(d.score);
                const popoverId = `pop-today-row-${i}`;
                return (
                  <div
                    role="row"
                    data-row
                    data-scope="today"
                    data-name={d.name.toLowerCase()}
                    data-tld={d.tld}
                    data-dropped={d.dropped_date}
                    data-wayback={d.wayback_snapshots}
                    data-opr={d.open_page_rank}
                    data-backlinks={d.cc_source_domain_count}
                    data-score={d.score}
                    class="grid grid-cols-[200px_80px_110px_110px_180px_110px_120px_1fr] items-center"
                  >
                    <div role="cell" class="px-4 py-3"><span class="font-medium text-ink">{d.name}</span></div>
                    <div role="cell" class="px-4 py-3">
                      <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>.{d.tld}</span>
                    </div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{droppedDaysAgo(d.dropped_date)}</div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{fmtInt(d.wayback_snapshots)}</div>
                    <div role="cell" class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <div class="h-1.5 w-24 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                          <div class="h-full bg-accent" style={`width: ${oprPct(d.open_page_rank)}%`}></div>
                        </div>
                        <span class="text-stone-700 tabular-nums text-xs w-8 text-right">{fmtDecimal(d.open_page_rank)}</span>
                      </div>
                    </div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{fmtInt(d.cc_source_domain_count)}</div>
                    <div role="cell" class="px-4 py-3">
                      <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>{verdict}</span>
                    </div>
                    {/*
                      Register cell: flex container with the button at left
                      and the popover (icons) immediately to its right.
                      Popover starts hidden (HTML hidden attribute → display:
                      none); JS toggles `flex` class on open so it lays out
                      INLINE inside the cell, in the 1fr slack space. No
                      absolute positioning — no overflow-clip, no overlap
                      with neighbouring columns.
                    */}
                    <div role="cell" class="px-4 py-3 flex items-center gap-3">
                      <button
                        type="button"
                        data-popover-trigger={popoverId}
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls={popoverId}
                        class="inline-flex shrink-0 items-center rounded-md border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors"
                      >
                        Register →
                      </button>
                      <div
                        id={popoverId}
                        data-popover={popoverId}
                        role="menu"
                        aria-label={`Register ${d.name} at`}
                        hidden
                        class="items-center gap-2"
                      >
                        {d.registrars.map((r) => {
                          const logo = REGISTRAR_LOGOS[r.name];
                          return (
                            <a href={r.url} target="_blank" rel="noopener sponsored" role="menuitem" title={r.name} aria-label={`Register at ${r.name}`}
                               class="shrink-0 block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40">
                              {logo
                                ? <img src={logo} alt="" width="20" height="20" class="block h-5 w-5 rounded-sm" loading="lazy" decoding="async" />
                                : <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">{r.name}</span>}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
          <p class="hidden px-4 py-8 text-center text-sm text-stone-500" data-empty-state data-empty-scope="today">
            No domains in Today's drops match your filters.
          </p>
        </div>

        <!-- Mobile cards for Card 1 -->
        <ul class="md:hidden space-y-3 p-3 max-h-[80vh] overflow-y-auto" data-card-list data-scope="today">
          {todayDomains.map((d, i) => {
            const verdict = verdictFromScore(d.score);
            const popoverId = `pop-today-card-${i}`;
            return (
              <li
                data-card
                data-scope="today"
                data-name={d.name.toLowerCase()}
                data-tld={d.tld}
                data-dropped={d.dropped_date}
                data-wayback={d.wayback_snapshots}
                data-opr={d.open_page_rank}
                data-backlinks={d.cc_source_domain_count}
                data-score={d.score}
                class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="font-medium text-ink break-all">{d.name}</span>
                  <span class={`shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>{verdict}</span>
                </div>
                <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">TLD</dt><dd>
                    <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>.{d.tld}</span>
                  </dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Dropped</dt>
                    <dd class="text-stone-800 tabular-nums">{droppedDaysAgo(d.dropped_date)}</dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Wayback snapshots</dt>
                    <dd class="text-stone-800 tabular-nums">{fmtInt(d.wayback_snapshots)}</dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">OpenPageRank</dt>
                    <dd class="flex items-center gap-2">
                      <div class="h-1.5 w-20 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                        <div class="h-full bg-accent" style={`width: ${oprPct(d.open_page_rank)}%`}></div>
                      </div>
                      <span class="text-stone-800 tabular-nums text-xs">{fmtDecimal(d.open_page_rank)}</span>
                    </dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Backlinks</dt>
                    <dd class="text-stone-800 tabular-nums">{fmtInt(d.cc_source_domain_count)}</dd></div>
                </dl>
                <div class="relative mt-4">
                  <button type="button" data-popover-trigger={popoverId} aria-haspopup="true" aria-expanded="false" aria-controls={popoverId}
                          class="block w-full text-center rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors">
                    Register →
                  </button>
                  <div id={popoverId} data-popover={popoverId} role="menu" aria-label={`Register ${d.name} at`} hidden
                       class="absolute left-1/2 -translate-x-1/2 top-full z-10 mt-1 items-center gap-2 rounded-md border border-stone-200 bg-white px-2 py-1 shadow-lg whitespace-nowrap">
                    {d.registrars.map((r) => {
                      const logo = REGISTRAR_LOGOS[r.name];
                      return (
                        <a href={r.url} target="_blank" rel="noopener sponsored" role="menuitem" title={r.name} aria-label={`Register at ${r.name}`}
                           class="shrink-0 block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40">
                          {logo
                            ? <img src={logo} alt="" width="20" height="20" class="block h-5 w-5 rounded-sm" loading="lazy" decoding="async" />
                            : <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">{r.name}</span>}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </li>
            );
          })}
          <li class="hidden text-center text-sm text-stone-500 py-6" data-empty-card data-empty-scope="today">
            No domains in Today's drops match your filters.
          </li>
        </ul>
      </>
    )}
  </article>

  <!-- =============== CARD 2: Recent drops =============== -->
  <article
    data-card-scope="carryover"
    class="rounded-lg border border-stone-200 bg-white shadow-sm"
  >
    <header class="px-4 sm:px-6 py-4 border-b border-stone-100">
      <h3 class="text-lg font-semibold text-ink">Recent drops</h3>
      <p class="mt-1 text-sm text-stone-600" data-carryover-subheader>
        {carryoverSubheader(carryoverDomains.length)}
      </p>
    </header>

    {carryoverDomains.length === 0 && (
      <div class="px-4 sm:px-6 py-10 text-center" data-carryover-empty-real>
        <p class="text-sm text-stone-700">
          The rolling list builds up over time — domains that survive
          today's check stay here for up to 14 days.
        </p>
      </div>
    )}

    {carryoverDomains.length > 0 && (
      <>
        <!-- Desktop table for Card 2 — same columns as Card 1 plus "Listed". -->
        <div class="hidden md:block max-h-[60rem] overflow-y-auto rounded-b-lg">
          {/*
            Same grid pattern as Card 1, with the Listed column inserted at
            position 4 (between Dropped and Wayback). Listed groups
            naturally with Dropped — both are temporal — so this ordering
            reads better than putting Listed at the far right next to
            Register. 8 columns total; Register column still 1fr to host
            the inline popover.
          */}
          <div role="table" class="w-full text-sm" data-domain-table data-table-scope="carryover">
            <div role="rowgroup" class="sticky top-0 z-10 bg-stone-50 text-stone-600 border-b border-stone-100">
              <div role="row" class="grid grid-cols-[200px_80px_110px_110px_110px_180px_110px_120px_1fr] font-medium">
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="name">
                    Domain <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="tld">
                    TLD <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="dropped">
                    Dropped <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="listed">
                    Listed <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="wayback">
                    Wayback <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="opr">
                    OpenPageRank <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="backlinks">
                    Backlinks <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader">
                  <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="score">
                    Verdict <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
                  </button>
                </div>
                <div role="columnheader" class="px-4 py-3 text-left">Register</div>
              </div>
            </div>
            <div role="rowgroup" class="divide-y divide-stone-100" data-table-body data-scope="carryover">
              {carryoverDomains.map((d, i) => {
                const verdict = verdictFromScore(d.score);
                const popoverId = `pop-carry-row-${i}`;
                const days = d.days_listed ?? 0;
                return (
                  <div
                    role="row"
                    data-row
                    data-scope="carryover"
                    data-name={d.name.toLowerCase()}
                    data-tld={d.tld}
                    data-dropped={d.dropped_date}
                    data-wayback={d.wayback_snapshots}
                    data-opr={d.open_page_rank}
                    data-backlinks={d.cc_source_domain_count}
                    data-score={d.score}
                    data-listed={days}
                    class="grid grid-cols-[200px_80px_110px_110px_110px_180px_110px_120px_1fr] items-center"
                  >
                    <div role="cell" class="px-4 py-3"><span class="font-medium text-ink">{d.name}</span></div>
                    <div role="cell" class="px-4 py-3">
                      <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>.{d.tld}</span>
                    </div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{droppedDaysAgo(d.dropped_date)}</div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-500">{listedAgo(days)}</div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{fmtInt(d.wayback_snapshots)}</div>
                    <div role="cell" class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <div class="h-1.5 w-24 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                          <div class="h-full bg-accent" style={`width: ${oprPct(d.open_page_rank)}%`}></div>
                        </div>
                        <span class="text-stone-700 tabular-nums text-xs w-8 text-right">{fmtDecimal(d.open_page_rank)}</span>
                      </div>
                    </div>
                    <div role="cell" class="px-4 py-3 text-right tabular-nums text-stone-700">{fmtInt(d.cc_source_domain_count)}</div>
                    <div role="cell" class="px-4 py-3">
                      <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>{verdict}</span>
                    </div>
                    <div role="cell" class="px-4 py-3 flex items-center gap-3">
                      <button
                        type="button"
                        data-popover-trigger={popoverId}
                        aria-haspopup="true"
                        aria-expanded="false"
                        aria-controls={popoverId}
                        class="inline-flex shrink-0 items-center rounded-md border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors"
                      >
                        Register →
                      </button>
                      <div
                        id={popoverId}
                        data-popover={popoverId}
                        role="menu"
                        aria-label={`Register ${d.name} at`}
                        hidden
                        class="items-center gap-2"
                      >
                        {d.registrars.map((r) => {
                          const logo = REGISTRAR_LOGOS[r.name];
                          return (
                            <a href={r.url} target="_blank" rel="noopener sponsored" role="menuitem" title={r.name} aria-label={`Register at ${r.name}`}
                               class="shrink-0 block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40">
                              {logo
                                ? <img src={logo} alt="" width="20" height="20" class="block h-5 w-5 rounded-sm" loading="lazy" decoding="async" />
                                : <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">{r.name}</span>}
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
          <p class="hidden px-4 py-8 text-center text-sm text-stone-500" data-empty-state data-empty-scope="carryover">
            No domains in Recent drops match your filters.
          </p>
        </div>

        <!-- Mobile cards for Card 2 — extra "Listed" row in the dl -->
        <ul class="md:hidden space-y-3 p-3 max-h-[80vh] overflow-y-auto" data-card-list data-scope="carryover">
          {carryoverDomains.map((d, i) => {
            const verdict = verdictFromScore(d.score);
            const popoverId = `pop-carry-card-${i}`;
            const days = d.days_listed ?? 0;
            return (
              <li
                data-card
                data-scope="carryover"
                data-name={d.name.toLowerCase()}
                data-tld={d.tld}
                data-dropped={d.dropped_date}
                data-wayback={d.wayback_snapshots}
                data-opr={d.open_page_rank}
                data-backlinks={d.cc_source_domain_count}
                data-score={d.score}
                data-listed={days}
                class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm"
              >
                <div class="flex items-start justify-between gap-3">
                  <span class="font-medium text-ink break-all">{d.name}</span>
                  <span class={`shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>{verdict}</span>
                </div>
                <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">TLD</dt><dd>
                    <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>.{d.tld}</span>
                  </dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Dropped</dt>
                    <dd class="text-stone-800 tabular-nums">{droppedDaysAgo(d.dropped_date)}</dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Listed</dt>
                    <dd class="text-stone-800 tabular-nums">{listedAgo(days)}</dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Wayback snapshots</dt>
                    <dd class="text-stone-800 tabular-nums">{fmtInt(d.wayback_snapshots)}</dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">OpenPageRank</dt>
                    <dd class="flex items-center gap-2">
                      <div class="h-1.5 w-20 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                        <div class="h-full bg-accent" style={`width: ${oprPct(d.open_page_rank)}%`}></div>
                      </div>
                      <span class="text-stone-800 tabular-nums text-xs">{fmtDecimal(d.open_page_rank)}</span>
                    </dd></div>
                  <div class="flex items-center justify-between col-span-2"><dt class="text-stone-500">Backlinks</dt>
                    <dd class="text-stone-800 tabular-nums">{fmtInt(d.cc_source_domain_count)}</dd></div>
                </dl>
                <div class="relative mt-4">
                  <button type="button" data-popover-trigger={popoverId} aria-haspopup="true" aria-expanded="false" aria-controls={popoverId}
                          class="block w-full text-center rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors">
                    Register →
                  </button>
                  <div id={popoverId} data-popover={popoverId} role="menu" aria-label={`Register ${d.name} at`} hidden
                       class="absolute left-1/2 -translate-x-1/2 top-full z-10 mt-1 items-center gap-2 rounded-md border border-stone-200 bg-white px-2 py-1 shadow-lg whitespace-nowrap">
                    {d.registrars.map((r) => {
                      const logo = REGISTRAR_LOGOS[r.name];
                      return (
                        <a href={r.url} target="_blank" rel="noopener sponsored" role="menuitem" title={r.name} aria-label={`Register at ${r.name}`}
                           class="shrink-0 block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40">
                          {logo
                            ? <img src={logo} alt="" width="20" height="20" class="block h-5 w-5 rounded-sm" loading="lazy" decoding="async" />
                            : <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">{r.name}</span>}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </li>
            );
          })}
          <li class="hidden text-center text-sm text-stone-500 py-6" data-empty-card data-empty-scope="carryover">
            No domains in Recent drops match your filters.
          </li>
        </ul>
      </>
    )}
  </article>
</section>

<script>
  type SortKey = 'name' | 'tld' | 'dropped' | 'wayback' | 'opr' | 'backlinks' | 'score' | 'listed';
  type SortDir = 'asc' | 'desc';
  type Scope = 'today' | 'carryover';

  // Sort state is per-scope so each card can sort independently. Default
  // is null (preserve pipeline order, which is score desc within bucket).
  const sortState: Record<Scope, { key: SortKey | null; dir: SortDir }> = {
    today:     { key: null, dir: 'asc' },
    carryover: { key: null, dir: 'asc' },
  };

  const search = document.querySelector<HTMLInputElement>('#domain-search');
  const tldFilter = document.querySelector<HTMLSelectElement>('#tld-filter');

  const readValue = (el: HTMLElement, key: SortKey): string | number | null => {
    const numOrNull = (attr: string): number | null => {
      const v = el.getAttribute(attr);
      return v === null || v === '' ? null : Number(v);
    };
    switch (key) {
      case 'name':      return el.getAttribute('data-name') ?? '';
      case 'tld':       return el.getAttribute('data-tld') ?? '';
      case 'dropped':   return el.getAttribute('data-dropped') ?? '';
      case 'wayback':   return numOrNull('data-wayback');
      case 'opr':       return numOrNull('data-opr');
      case 'backlinks': return numOrNull('data-backlinks');
      case 'score':     return numOrNull('data-score');
      case 'listed':    return numOrNull('data-listed');
    }
  };

  const sortContainer = (
    container: HTMLElement | null,
    selector: string,
    state: { key: SortKey | null; dir: SortDir },
  ) => {
    if (!container || !state.key) return;
    const items = Array.from(container.querySelectorAll<HTMLElement>(selector));
    items.sort((a, b) => {
      const va = readValue(a, state.key!);
      const vb = readValue(b, state.key!);
      const aMissing = va === null || va === undefined;
      const bMissing = vb === null || vb === undefined;
      if (aMissing && bMissing) return 0;
      if (aMissing) return 1;
      if (bMissing) return -1;
      let cmp: number;
      if (typeof va === 'number' && typeof vb === 'number') {
        cmp = va - vb;
      } else {
        cmp = String(va).localeCompare(String(vb));
      }
      return state.dir === 'asc' ? cmp : -cmp;
    });
    items.forEach((el) => container.appendChild(el));
  };

  const updateIndicators = (scope: Scope) => {
    const state = sortState[scope];
    document
      .querySelectorAll<HTMLButtonElement>(`[data-card-scope="${scope}"] [data-sort-key]`)
      .forEach((btn) => {
        const indicator = btn.querySelector<HTMLElement>('.sort-indicator');
        if (!indicator) return;
        if (btn.dataset.sortKey === state.key) {
          indicator.textContent = state.dir === 'asc' ? '↑' : '↓';
          indicator.classList.remove('text-stone-300');
          indicator.classList.add('text-accent');
        } else {
          indicator.textContent = '↕';
          indicator.classList.add('text-stone-300');
          indicator.classList.remove('text-accent');
        }
      });
  };

  // Filter (search + TLD) applies GLOBALLY to both scopes. Recount visible
  // rows per scope so each card's empty-state and subheader stay accurate.
  const applyFilters = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    const tld = tldFilter?.value ?? 'all';

    const matches = (el: HTMLElement) => {
      const name = el.getAttribute('data-name') ?? '';
      const elTld = el.getAttribute('data-tld') ?? '';
      const matchesQuery = q === '' || name.includes(q);
      const matchesTld = tld === 'all' || elTld === tld;
      return matchesQuery && matchesTld;
    };

    const visibleByScope: Record<Scope, number> = { today: 0, carryover: 0 };

    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      const show = matches(row);
      row.classList.toggle('hidden', !show);
      if (show) {
        const scope = (row.getAttribute('data-scope') ?? 'today') as Scope;
        visibleByScope[scope]++;
      }
    });

    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      card.classList.toggle('hidden', !matches(card));
    });

    // Empty-state messages — only show when filters reduce a scope to zero
    // AND that scope had data to begin with (otherwise the static
    // "No new drops yet today" / "rolling list builds up" messages from the
    // Astro template are the right copy).
    (['today', 'carryover'] as Scope[]).forEach((scope) => {
      const visible = visibleByScope[scope];
      const total = document.querySelectorAll(`[data-row][data-scope="${scope}"]`).length;
      const hadData = total > 0;
      document
        .querySelectorAll<HTMLElement>(`[data-empty-state][data-empty-scope="${scope}"], [data-empty-card][data-empty-scope="${scope}"]`)
        .forEach((el) => {
          el.classList.toggle('hidden', !(hadData && visible === 0));
        });
    });
  };

  const handleSort = (scope: Scope, key: SortKey) => {
    const state = sortState[scope];
    if (state.key === key) {
      state.dir = state.dir === 'asc' ? 'desc' : 'asc';
    } else {
      state.key = key;
      state.dir = 'asc';
    }
    const tableBody = document.querySelector<HTMLElement>(
      `[data-table-body][data-scope="${scope}"]`,
    );
    const cardList = document.querySelector<HTMLElement>(
      `[data-card-list][data-scope="${scope}"]`,
    );
    sortContainer(tableBody, '[data-row]', state);
    sortContainer(cardList,  '[data-card]', state);
    updateIndicators(scope);
  };

  // Each sort button lives inside an <article data-card-scope="..."> — derive
  // the scope from the closest ancestor so the same button class works in
  // both cards.
  document.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sortKey as SortKey | undefined;
      if (!key) return;
      const article = btn.closest<HTMLElement>('[data-card-scope]');
      const scope = (article?.getAttribute('data-card-scope') ?? 'today') as Scope;
      handleSort(scope, key);
    });
  });

  search?.addEventListener('input', applyFilters);
  tldFilter?.addEventListener('change', applyFilters);

  // --- Register popover ---------------------------------------------------
  // One delegated click listener for ALL popovers across both cards.
  // Tap-to-open / tap-outside / Escape to close. Display toggle uses both
  // the HTML `hidden` attribute AND a `flex` class so the popover's
  // horizontal layout (display: flex) is in effect only when open.
  const closeAllPopovers = () => {
    document.querySelectorAll<HTMLElement>('[data-popover]').forEach((p) => {
      p.hidden = true;
      p.classList.remove('flex');
    });
    document.querySelectorAll<HTMLButtonElement>('[data-popover-trigger]').forEach((t) => {
      t.setAttribute('aria-expanded', 'false');
    });
  };

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target) return;

    const trigger = target.closest('[data-popover-trigger]');
    if (trigger) {
      const id = trigger.getAttribute('data-popover-trigger');
      if (!id) return;
      const popover = document.querySelector<HTMLElement>(`[data-popover="${id}"]`);
      if (!popover) return;
      const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllPopovers();
      if (!wasOpen) {
        popover.hidden = false;
        popover.classList.add('flex');
        trigger.setAttribute('aria-expanded', 'true');
      }
      return;
    }

    if (target.closest('[data-popover]')) return;

    closeAllPopovers();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPopovers();
  });
</script>
