---
import samplePayload from '../data/sample-domains.json';

// Pipeline output (locked schema — PLAN.md Principle 5, with the
// 2026-04-27-evening migration: single affiliate_link → registrars[]).
// The pipeline composes each registrar URL using the configured template;
// the site uses them verbatim, never re-derives or URL-encodes.
interface RegistrarLink {
  name: string;                    // "Namecheap", "NameSilo", ...
  url: string;                     // affiliate URL with {name} substituted
}

interface PipelineDomain {
  name: string;
  tld: string;
  dropped_date: string;            // ISO YYYY-MM-DD
  wayback_snapshots: number;
  wayback_last_snapshot: string | null;
  open_page_rank: number;
  cert_history: boolean;
  previous_registrar: string | null;
  score: number;                   // 0–100
  registrars: RegistrarLink[];     // popover render order = config order
}

interface PipelinePayload {
  generated_at: string;            // ISO 8601
  domain_count: number;
  domains: PipelineDomain[];
}

type Verdict = 'Clean' | 'Promising' | 'Caution';

// --- Data source resolution ---------------------------------------------------
// The pipeline writes src/data/daily-domains.json daily via GitHub Actions.
// On cold start (day 1) it produces an empty domains array; if the workflow
// fails entirely the file may be absent. Either way, fall back to the sample
// preview so the page always renders.
//
// import.meta.glob handles the missing-file case gracefully (eager-loaded
// matches yield {} when the path doesn't exist), unlike a static import.
const dailyMatches = import.meta.glob<{ default: PipelinePayload }>(
  '../data/daily-domains.json',
  { eager: true },
);
const dailyPayload = Object.values(dailyMatches)[0]?.default;

const isPreview = !dailyPayload || !dailyPayload.domains || dailyPayload.domains.length === 0;
const payload: PipelinePayload = isPreview
  ? (samplePayload as PipelinePayload)
  : (dailyPayload as PipelinePayload);
const domains = payload.domains;

const lastUpdatedLabel = isPreview
  ? 'Preview data'
  : new Date(payload.generated_at).toUTCString().replace('GMT', 'UTC');

const tldsInData = Array.from(new Set(domains.map((d) => d.tld))).sort();

// --- Display helpers ----------------------------------------------------------

const verdictFromScore = (score: number): Verdict => {
  if (score >= 70) return 'Clean';
  if (score >= 40) return 'Promising';
  return 'Caution';
};

// Build-time relative-date label. Cloudflare Pages rebuilds when the pipeline
// commits the daily JSON, so this stays accurate to the daily refresh.
const droppedDaysAgo = (isoDate: string): string => {
  const dropped = new Date(`${isoDate}T00:00:00Z`);
  const now = new Date();
  const ms = now.getTime() - dropped.getTime();
  const days = Math.floor(ms / (1000 * 60 * 60 * 24));
  if (days <= 0) return 'today';
  if (days === 1) return '1 day ago';
  return `${days} days ago`;
};

const tldClass = (tld: string) => {
  switch (tld) {
    case 'org':
      return 'bg-violet-50 text-violet-800 ring-violet-200';
    case 'info':
      return 'bg-emerald-50 text-emerald-800 ring-emerald-200';
    case 'dev':
      return 'bg-sky-50 text-sky-800 ring-sky-200';
    case 'app':
      return 'bg-amber-50 text-amber-800 ring-amber-200';
    case 'tech':
    case 'studio':
      return 'bg-indigo-50 text-indigo-800 ring-indigo-200';
    case 'xyz':
      return 'bg-rose-50 text-rose-800 ring-rose-200';
    default:
      return 'bg-stone-100 text-stone-700 ring-stone-200';
  }
};

// Registrar name → local logo path. Add new affiliates by dropping a PNG
// into public/registrar-logos/ and adding the entry here. If a registrar
// name isn't in this map the popover falls back to rendering the name as
// text (graceful degradation — the link still works, just without a logo).
const REGISTRAR_LOGOS: Record<string, string> = {
  'Namecheap': '/registrar-logos/namecheap.png',
  'NameSilo':  '/registrar-logos/namesilo.png',
};

const verdictClass = (verdict: Verdict) => {
  switch (verdict) {
    case 'Clean':
      return 'bg-emerald-50 text-emerald-800 ring-emerald-200';
    case 'Promising':
      return 'bg-amber-50 text-amber-900 ring-amber-200';
    case 'Caution':
      return 'bg-rose-50 text-rose-800 ring-rose-200';
  }
};
---

<section id="today" class="mx-auto max-w-6xl px-4 sm:px-6 pt-6 pb-12 sm:pt-8 sm:pb-16">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-6">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">Today's drops</h2>
        {isPreview && (
          <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-900 ring-1 ring-inset ring-amber-200">
            Preview data
          </span>
        )}
      </div>
      <p class="mt-2 text-sm text-stone-600">
        <span data-result-count>Showing {domains.length} of {domains.length} domains</span>
        <span class="text-stone-400"> • </span>
        <span>
          Last updated: <span data-last-updated>{lastUpdatedLabel}</span>
        </span>
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
      <label class="sr-only" for="domain-search">Search domains</label>
      <div class="relative">
        <input
          id="domain-search"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="Search domains…"
          class="w-full sm:w-64 rounded-md border border-stone-300 bg-white pl-9 pr-3 py-2 text-sm text-ink placeholder:text-stone-400 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
        />
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          class="absolute left-2.5 top-1/2 -translate-y-1/2 h-4 w-4 text-stone-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="9" cy="9" r="6" />
          <path d="m14 14 4 4" stroke-linecap="round" />
        </svg>
      </div>

      <label class="sr-only" for="tld-filter">Filter by TLD</label>
      <select
        id="tld-filter"
        class="rounded-md border border-stone-300 bg-white px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      >
        <option value="all">All TLDs</option>
        {tldsInData.map((t) => <option value={t}>.{t} only</option>)}
      </select>
    </div>
  </div>

  <!-- Desktop / tablet table -->
  <div class="hidden md:block overflow-hidden rounded-lg border border-stone-200 bg-white shadow-sm">
    <table class="w-full text-sm" data-domain-table>
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th scope="col" class="text-left font-medium">
            <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="name">
              Domain <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-left font-medium">
            <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="tld">
              TLD <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-right font-medium">
            <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="dropped">
              Dropped <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-right font-medium">
            <button type="button" class="w-full text-right px-4 py-3 hover:text-ink flex items-center justify-end gap-1" data-sort-key="wayback">
              Wayback <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-left font-medium">
            <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="opr">
              OpenPageRank <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-left font-medium">
            <button type="button" class="w-full text-left px-4 py-3 hover:text-ink flex items-center gap-1" data-sort-key="score">
              Verdict <span class="sort-indicator text-stone-300" aria-hidden="true">↕</span>
            </button>
          </th>
          <th scope="col" class="text-right font-medium px-4 py-3">Register</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100" data-table-body>
        {
          domains.map((d, i) => {
            const verdict = verdictFromScore(d.score);
            const popoverId = `pop-row-${i}`;
            return (
              <tr
                data-row
                data-name={d.name.toLowerCase()}
                data-tld={d.tld}
                data-dropped={d.dropped_date}
                data-wayback={d.wayback_snapshots}
                data-opr={d.open_page_rank}
                data-score={d.score}
              >
                <td class="px-4 py-3">
                  <span class="font-medium text-ink">{d.name}</span>
                </td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>
                    .{d.tld}
                  </span>
                </td>
                <td class="px-4 py-3 text-right tabular-nums text-stone-700">{droppedDaysAgo(d.dropped_date)}</td>
                <td class="px-4 py-3 text-right tabular-nums text-stone-700">{d.wayback_snapshots.toLocaleString('en-US')}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="h-1.5 w-24 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                      <div class="h-full bg-accent" style={`width: ${(d.open_page_rank / 10) * 100}%`}></div>
                    </div>
                    <span class="text-stone-700 tabular-nums text-xs w-8 text-right">{d.open_page_rank.toFixed(1)}</span>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>
                    {verdict}
                  </span>
                </td>
                <td class="px-4 py-3 text-right relative">
                  <button
                    type="button"
                    data-popover-trigger={popoverId}
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={popoverId}
                    class="inline-flex items-center rounded-md border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors"
                  >
                    Register →
                  </button>
                  <div
                    id={popoverId}
                    data-popover={popoverId}
                    role="menu"
                    aria-label={`Register ${d.name} at`}
                    hidden
                    class="absolute right-4 top-full z-10 mt-1 items-center gap-3 rounded-md border border-stone-200 bg-white px-3 py-2 shadow-lg whitespace-nowrap"
                  >
                    <span class="text-[10px] font-medium uppercase tracking-wide text-stone-500">
                      Register at:
                    </span>
                    <ul class="flex items-center gap-2">
                      {d.registrars.map((r) => {
                        const logo = REGISTRAR_LOGOS[r.name];
                        return (
                          <li class="shrink-0">
                            <a
                              href={r.url}
                              target="_blank"
                              rel="noopener sponsored"
                              role="menuitem"
                              title={r.name}
                              aria-label={`Register at ${r.name}`}
                              class="block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40"
                            >
                              {logo ? (
                                <img
                                  src={logo}
                                  alt=""
                                  width="20"
                                  height="20"
                                  class="block h-5 w-5 rounded-sm"
                                  loading="lazy"
                                  decoding="async"
                                />
                              ) : (
                                <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">
                                  {r.name}
                                </span>
                              )}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>

    <p class="hidden px-4 py-8 text-center text-sm text-stone-500" data-empty-state>
      No domains match your filters.
    </p>
  </div>

  <!-- Mobile card layout -->
  <ul class="md:hidden space-y-3" data-card-list>
    {
      domains.map((d, i) => {
        const verdict = verdictFromScore(d.score);
        const popoverId = `pop-card-${i}`;
        return (
          <li
            data-card
            data-name={d.name.toLowerCase()}
            data-tld={d.tld}
            data-dropped={d.dropped_date}
            data-wayback={d.wayback_snapshots}
            data-opr={d.open_page_rank}
            data-score={d.score}
            class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm"
          >
            <div class="flex items-start justify-between gap-3">
              <span class="font-medium text-ink break-all">{d.name}</span>
              <span class={`shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${verdictClass(verdict)}`}>
                {verdict}
              </span>
            </div>

            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
              <div class="flex items-center justify-between col-span-2">
                <dt class="text-stone-500">TLD</dt>
                <dd>
                  <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${tldClass(d.tld)}`}>
                    .{d.tld}
                  </span>
                </dd>
              </div>
              <div class="flex items-center justify-between col-span-2">
                <dt class="text-stone-500">Dropped</dt>
                <dd class="text-stone-800 tabular-nums">{droppedDaysAgo(d.dropped_date)}</dd>
              </div>
              <div class="flex items-center justify-between col-span-2">
                <dt class="text-stone-500">Wayback snapshots</dt>
                <dd class="text-stone-800 tabular-nums">{d.wayback_snapshots.toLocaleString('en-US')}</dd>
              </div>
              <div class="flex items-center justify-between col-span-2">
                <dt class="text-stone-500">OpenPageRank</dt>
                <dd class="flex items-center gap-2">
                  <div class="h-1.5 w-20 rounded-full bg-stone-100 overflow-hidden" aria-hidden="true">
                    <div class="h-full bg-accent" style={`width: ${(d.open_page_rank / 10) * 100}%`}></div>
                  </div>
                  <span class="text-stone-800 tabular-nums text-xs">{d.open_page_rank.toFixed(1)}</span>
                </dd>
              </div>
            </dl>

            <div class="relative mt-4">
              <button
                type="button"
                data-popover-trigger={popoverId}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={popoverId}
                class="block w-full text-center rounded-md border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:border-accent hover:text-accent transition-colors"
              >
                Register →
              </button>
              <div
                id={popoverId}
                data-popover={popoverId}
                role="menu"
                aria-label={`Register ${d.name} at`}
                hidden
                class="absolute left-1/2 -translate-x-1/2 top-full z-10 mt-1 flex items-center gap-3 rounded-md border border-stone-200 bg-white px-3 py-2 shadow-lg whitespace-nowrap"
              >
                <span class="text-[10px] font-medium uppercase tracking-wide text-stone-500">
                  Register at:
                </span>
                <ul class="flex items-center gap-2">
                  {d.registrars.map((r) => {
                    const logo = REGISTRAR_LOGOS[r.name];
                    return (
                      <li class="shrink-0">
                        <a
                          href={r.url}
                          target="_blank"
                          rel="noopener sponsored"
                          role="menuitem"
                          title={r.name}
                          aria-label={`Register at ${r.name}`}
                          class="block rounded hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-accent/40"
                        >
                          {logo ? (
                            <img
                              src={logo}
                              alt=""
                              width="20"
                              height="20"
                              class="block h-5 w-5 rounded-sm"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="px-1.5 py-0.5 text-xs text-stone-700 hover:text-accent">
                              {r.name}
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          </li>
        );
      })
    }
    <li class="hidden text-center text-sm text-stone-500 py-6" data-empty-card>
      No domains match your filters.
    </li>
  </ul>
</section>

<script>
  type SortKey = 'name' | 'tld' | 'dropped' | 'wayback' | 'opr' | 'score';
  type SortDir = 'asc' | 'desc';

  const totalCount = document.querySelectorAll<HTMLElement>('[data-row]').length;
  const search = document.querySelector<HTMLInputElement>('#domain-search');
  const tldFilter = document.querySelector<HTMLSelectElement>('#tld-filter');
  const tableBody = document.querySelector<HTMLElement>('[data-table-body]');
  const cardList = document.querySelector<HTMLElement>('[data-card-list]');
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyTable = document.querySelector<HTMLElement>('[data-empty-state]');
  const emptyCards = document.querySelector<HTMLElement>('[data-empty-card]');

  let sortKey: SortKey | null = null;
  let sortDir: SortDir = 'asc';

  const readValue = (el: HTMLElement, key: SortKey): string | number => {
    switch (key) {
      case 'name':
        return el.getAttribute('data-name') ?? '';
      case 'tld':
        return el.getAttribute('data-tld') ?? '';
      case 'dropped':
        // ISO YYYY-MM-DD sorts lexicographically the same as chronologically.
        return el.getAttribute('data-dropped') ?? '';
      case 'wayback':
        return Number(el.getAttribute('data-wayback') ?? 0);
      case 'opr':
        return Number(el.getAttribute('data-opr') ?? 0);
      case 'score':
        return Number(el.getAttribute('data-score') ?? 0);
    }
  };

  const sortContainer = (container: HTMLElement | null, selector: string) => {
    if (!container || !sortKey) return;
    const items = Array.from(container.querySelectorAll<HTMLElement>(selector));
    items.sort((a, b) => {
      const va = readValue(a, sortKey!);
      const vb = readValue(b, sortKey!);
      let cmp: number;
      if (typeof va === 'number' && typeof vb === 'number') {
        cmp = va - vb;
      } else {
        cmp = String(va).localeCompare(String(vb));
      }
      return sortDir === 'asc' ? cmp : -cmp;
    });
    items.forEach((el) => container.appendChild(el));
  };

  const updateIndicators = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((btn) => {
      const indicator = btn.querySelector<HTMLElement>('.sort-indicator');
      if (!indicator) return;
      if (btn.dataset.sortKey === sortKey) {
        indicator.textContent = sortDir === 'asc' ? '↑' : '↓';
        indicator.classList.remove('text-stone-300');
        indicator.classList.add('text-accent');
      } else {
        indicator.textContent = '↕';
        indicator.classList.add('text-stone-300');
        indicator.classList.remove('text-accent');
      }
    });
  };

  const applyFilters = () => {
    const q = (search?.value ?? '').trim().toLowerCase();
    const tld = tldFilter?.value ?? 'all';

    let visible = 0;
    const matches = (el: HTMLElement) => {
      const name = el.getAttribute('data-name') ?? '';
      const elTld = el.getAttribute('data-tld') ?? '';
      const matchesQuery = q === '' || name.includes(q);
      const matchesTld = tld === 'all' || elTld === tld;
      return matchesQuery && matchesTld;
    };

    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      const show = matches(row);
      row.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      card.classList.toggle('hidden', !matches(card));
    });

    if (resultCount) {
      resultCount.textContent = `Showing ${visible} of ${totalCount} domains`;
    }
    emptyTable?.classList.toggle('hidden', visible !== 0);
    emptyCards?.classList.toggle('hidden', visible !== 0);
  };

  const handleSort = (key: SortKey) => {
    if (sortKey === key) {
      sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
      sortKey = key;
      sortDir = 'asc';
    }
    sortContainer(tableBody, '[data-row]');
    sortContainer(cardList, '[data-card]');
    updateIndicators();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sortKey as SortKey | undefined;
      if (key) handleSort(key);
    });
  });

  search?.addEventListener('input', applyFilters);
  tldFilter?.addEventListener('change', applyFilters);

  // --- Register popover ---------------------------------------------------
  // Click a Register button → its popover opens (and any other open one
  // closes). Click outside any trigger/popover → close. Escape → close.
  // Tap-friendly on touch devices (no hover behaviour).
  //
  // Display toggle uses BOTH the HTML `hidden` attribute AND a `flex` class.
  // The popover's horizontal layout is `display: flex`; the `hidden`
  // attribute alone (`display: none` from the UA stylesheet) loses to any
  // author-stylesheet `display` rule. By gating `flex` on open-state we
  // guarantee `display: none` wins when closed and `display: flex` when open.
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-popover-trigger]');
  const popovers = document.querySelectorAll<HTMLElement>('[data-popover]');

  const closeAllPopovers = () => {
    popovers.forEach((p) => {
      p.hidden = true;
      p.classList.remove('flex');
    });
    triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = trigger.getAttribute('data-popover-trigger');
      if (!id) return;
      const target = document.querySelector<HTMLElement>(`[data-popover="${id}"]`);
      if (!target) return;
      const wasOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllPopovers();
      if (!wasOpen) {
        target.hidden = false;
        target.classList.add('flex');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  document.addEventListener('click', (e) => {
    const inside = (e.target as Element | null)?.closest(
      '[data-popover-trigger], [data-popover]'
    );
    if (!inside) closeAllPopovers();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPopovers();
  });
</script>
