# dependencies
node_modules/

# build output
dist/
.astro/

# environment
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# cloudflare / wrangler
.wrangler/
.dev.vars

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# claude code local state
.claude/

# local audits / one-off artifacts
*.report.html

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# zone files — never commit, regardless of compression
*.zone
*.zone.gz
*.zone.txt

# state files — yesterday snapshots live in Cloudflare R2, not in the repo.
# Per-TLD snapshots can exceed 200 MB and break GitHub's 100 MB file limit.
# Only the .gitkeep stays tracked so the directory still exists for any
# future local runs that materialise state on disk.
scripts/state/*
!scripts/state/.gitkeep